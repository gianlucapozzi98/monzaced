# =============================================================================
# Monza CED — configurazione del server (copiare in .env e compilare)
# Se manca qualcosa di essenziale, il caricamento documenti e i moduli restano
# in "modalità sicura": il sito mostra telefono e indirizzo e NON accetta invii.
# =============================================================================

# Indirizzo pubblico del sito (canonical, sitemap, link nelle notifiche)
SITE_URL=https://monzaced.it
HOST=127.0.0.1
PORT=4321
# 1 se il sito è dietro un proxy (nginx, Caddy, Cloudflare) che imposta X-Forwarded-For
TRUST_PROXY=1
# 1 per inviare l'intestazione HSTS (solo con HTTPS attivo)
HSTS=1

# Segreto per firmare sessioni, gettoni dei moduli e link di caricamento (almeno 32 caratteri casuali)
# Genera con: npm run genera-chiave
SEGRETO_APP=

# Anteprima con segnaposto evidenti per i contenuti mancanti (true in anteprima, false in produzione)
PUBLIC_MOSTRA_SEGNAPOSTO=true

# --- Archivio dei documenti (obbligatorio) -----------------------------------
# "s3" = bucket S3-compatibile PRIVATO in UE (consigliato)  |  "locale" = cartella cifrata sul server
ARCHIVIO_DRIVER=s3
# Esempi di fornitori in UE: AWS eu-south-1 (Milano), Scaleway fr-par, OVHcloud, Backblaze eu-central
S3_ENDPOINT=https://s3.eu-south-1.amazonaws.com
S3_REGION=eu-south-1
S3_BUCKET=monzaced-documenti
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cifratura lato server richiesta su ogni oggetto. "none" solo se il fornitore cifra già tutto di default.
S3_SSE=AES256
# Solo con ARCHIVIO_DRIVER=locale: cartella e chiave AES-256 (32 byte in base64, npm run genera-chiave)
ARCHIVIO_LOCALE_CARTELLA=.data/archivio
ARCHIVIO_LOCALE_CHIAVE=

# --- Antivirus (obbligatorio) --------------------------------------------------
# "clamd" = servizio ClamAV (es. container clamav/clamav sulla stessa macchina)
ANTIVIRUS_DRIVER=clamd
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=30000

# --- Notifiche allo studio (obbligatorie) --------------------------------------
# Le email contengono solo codice pratica, servizio e link all'area riservata: MAI allegati.
NOTIFICHE_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
NOTIFICA_DA=sito@monzaced.it
NOTIFICA_A=ingresso@monzaced.it

# --- Area riservata dello studio (obbligatoria) --------------------------------
# Righe create con: npm run hash-password -- nomeutente [--totp]   (più utenti separati da virgola)
UTENTI_STUDIO=

# --- Limiti e conservazione (da decidere con lo studio) ------------------------
UPLOAD_MAX_FILE=10
UPLOAD_MAX_MB=15
# Limiti anti-abuso per indirizzo IP, ogni 10 minuti (predefiniti 6 caricamenti e 5 richieste)
LIMITE_CARICAMENTI_10MIN=6
LIMITE_RICHIESTE_10MIN=5
# Giorni dopo i quali i documenti caricati vengono cancellati automaticamente. OBBLIGATORIO: senza, il caricamento resta spento.
CONSERVAZIONE_GIORNI=
# Giorni di conservazione del registro eventi (accessi, scaricamenti)
REGISTRO_GIORNI=365
# Gettone per la pulizia automatica (almeno 24 caratteri casuali): server.mjs la esegue ogni 6 ore
MANUTENZIONE_TOKEN=

# --- Pannello dei testi in produzione (facoltativo) ----------------------------
# PUBLIC_KEYSTATIC_STORAGE=github
# PUBLIC_KEYSTATIC_GITHUB_REPO=proprietario/monza-ced-sito
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=

# --- SOLO PER PROVE IN LOCALE: mai in produzione --------------------------------
# MODALITA_PROVA=1 consente ANTIVIRUS_DRIVER=prova-eicar e NOTIFICHE_DRIVER=prova-file
MODALITA_PROVA=0
