{
  "name": "monza-ced-sito",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/verifica-contenuti.mjs && astro check && astro build",
    "build:veloce": "astro build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "preview": "node --env-file-if-exists=.env server.mjs",
    "check": "astro check",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "contenuti": "node scripts/verifica-contenuti.mjs",
    "icone": "node scripts/genera-icone.mjs",
    "purge": "node --env-file-if-exists=.env scripts/cancella-scaduti.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "genera-chiave": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.10",
    "astro": "^7.4.13",
    "aws4fetch": "^1.0.20",
    "compression": "^1.8.2",
    "gsap": "^3.15.1",
    "js-yaml": "^5.5.0",
    "lenis": "^1.3.28",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/js-yaml": "^4.0.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
