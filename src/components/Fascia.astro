---
/** Fascia scorrevole: l'unico movimento continuo del sito. Si ferma fuori schermo, con il pulsante Pausa e con "riduci movimento". */
import Icon from './Icon.astro';
interface Props { parole: string[]; scura?: boolean }
const { parole, scura = true } = Astro.props;
---
<div class:list={['fascia', { 'su-scuro': scura }]} data-fascia>
  <div class="fascia__binario" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="fascia__giro">
        {parole.map((p) => (<li><span>{p}</span><svg viewBox="0 0 24 24" width="22" height="22" focusable="false"><circle cx="12" cy="12" r="6" /></svg></li>))}
      </ul>
    ))}
  </div>
  <button type="button" class="fascia__pausa" aria-pressed="false" data-fascia-pausa>
    <span class="fascia__ico-pausa"><Icon name="pausa" size={20} /></span><span class="fascia__ico-play"><Icon name="play" size={20} /></span>
    <span class="sr-only">Metti in pausa la fascia scorrevole</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fascia]').forEach((f) => {
    const btn = f.querySelector<HTMLButtonElement>('[data-fascia-pausa]')!;
    let utentePausa = false;
    const aggiorna = (inVista: boolean) => f.classList.toggle('in-moto', inVista && !utentePausa);
    let visibile = false;
    new IntersectionObserver(([e]) => { visibile = e.isIntersecting; aggiorna(visibile); }, { rootMargin: '100px' }).observe(f);
    btn.addEventListener('click', () => {
      utentePausa = !utentePausa;
      btn.setAttribute('aria-pressed', String(utentePausa));
      btn.querySelector('.sr-only')!.textContent = utentePausa ? 'Riprendi la fascia scorrevole' : 'Metti in pausa la fascia scorrevole';
      aggiorna(visibile);
    });
  });
</script>

<style>
  .fascia { position: relative; overflow: hidden; padding: 26px 0; border-radius: 999px; margin-inline: var(--gutter); }
  .fascia__binario { display: flex; width: max-content; }
  .fascia__giro { display: flex; list-style: none; margin: 0; padding: 0; animation: fascia 60s linear infinite; animation-play-state: paused; }
  :global(.fascia.in-moto) .fascia__giro { animation-play-state: running; }
  .fascia li { display: flex; align-items: center; gap: 34px; margin: 0 34px 0 0; white-space: nowrap; }
  .fascia li span { font-family: var(--f-titoli); font-weight: 800; font-size: clamp(1.8rem, 1.2rem + 2.4vw, 3.4rem); letter-spacing: -0.03em; }
  .fascia li:nth-child(even) span { font-style: italic; color: var(--blu); }
  .fascia svg { fill: none; stroke: var(--blu); stroke-width: 3; }
  .fascia__pausa {
    position: absolute; right: 18px; top: 50%; translate: 0 -50%; width: 48px; height: 48px; border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.6); background: var(--inchiostro); color: #fff; display: grid; place-items: center; cursor: pointer;
  }
  .fascia:not(.su-scuro) .fascia__pausa { background: var(--bianco); color: var(--inchiostro); border-color: var(--inchiostro); }
  .fascia__ico-play { display: none; }
  .fascia__pausa[aria-pressed='true'] .fascia__ico-play { display: inline; }
  .fascia__pausa[aria-pressed='true'] .fascia__ico-pausa { display: none; }
  @keyframes fascia { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .fascia__giro { animation: none; }
    .fascia__binario { width: auto; flex-wrap: wrap; }
    .fascia__giro + .fascia__giro { display: none; }
    .fascia__giro { flex-wrap: wrap; padding-inline: 28px; row-gap: 8px; }
    .fascia__pausa { display: none; }
  }
</style>
