---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { impostazioni, convenzioni, getNotizie } from '@/lib/content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const voci = [
  { href: '/servizi', testo: 'Servizi' },
  { href: '/chi-siamo', testo: 'Chi siamo' },
  ...(convenzioni.pubblicata ? [{ href: '/convenzioni-offerte', testo: 'Convenzioni' }] : []),
  ...(getNotizie().length ? [{ href: '/notizie', testo: 'Notizie' }] : []),
  { href: '/contatti', testo: 'Contatti' },
];
const attiva = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---
<header class="testata no-stampa" data-testata>
  <div class="testata__barra su-scuro">
    <a class="testata__logo" href="/" aria-label="Monza CED, torna alla home">
      <Logo titolo="Monza CED" />
    </a>
    <nav class="testata__nav" aria-label="Principale">
      <ul>
        {voci.map((v) => (
          <li><a href={v.href} aria-current={attiva(v.href)}>{v.testo}</a></li>
        ))}
        <li>
          <a href="/cerca" aria-current={attiva('/cerca')} class="testata__cerca">
            <Icon name="cerca" size={20} /> Cerca
          </a>
        </li>
      </ul>
    </nav>
    <div class="testata__azioni">
      <a class="btn btn--piccolo btn--secondario" href={impostazioni.ctaCarica.link} aria-label={impostazioni.ctaCarica.testo}>
        <Icon name="carica" size={20} /> <span class="lungo">{impostazioni.ctaCarica.testo}</span><span class="breve">Carica</span>
      </a>
      <a class="btn btn--piccolo testata__prenota" href={impostazioni.ctaPrenota.link}>{impostazioni.ctaPrenota.testo}</a>
    </div>
    <button class="testata__menu" type="button" aria-haspopup="dialog" aria-controls="menu-mobile" data-apri-menu>
      <Icon name="menu" size={26} /> <span>Menu</span>
    </button>
  </div>

  <dialog id="menu-mobile" class="menu-mobile su-scuro" aria-label="Menu">
    <div class="menu-mobile__testa">
      <Logo titolo="Monza CED" />
      <button type="button" class="menu-mobile__chiudi" data-chiudi-menu>
        <Icon name="x" size={26} /> <span>Chiudi</span>
      </button>
    </div>
    <nav aria-label="Principale (mobile)">
      <ul>
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {voci.map((v) => (<li><a href={v.href} aria-current={attiva(v.href)}>{v.testo}</a></li>))}
        <li><a href="/cerca">Cerca un servizio</a></li>
      </ul>
    </nav>
    <div class="menu-mobile__azioni">
      <a class="btn" href={impostazioni.ctaPrenota.link}>{impostazioni.ctaPrenota.testo}</a>
      <a class="btn btn--secondario" href={impostazioni.ctaCarica.link}><Icon name="carica" size={20} /> {impostazioni.ctaCarica.testo}</a>
      <a class="menu-mobile__tel" href={`tel:${impostazioni.telefonoLink}`}><Icon name="telefono" /> {impostazioni.telefono}</a>
    </div>
  </dialog>
</header>

<script>
  const dlg = document.getElementById('menu-mobile') as HTMLDialogElement | null;
  const apri = document.querySelector<HTMLButtonElement>('[data-apri-menu]');
  apri?.addEventListener('click', () => { dlg?.showModal(); });
  dlg?.querySelector('[data-chiudi-menu]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('close', () => apri?.focus());
  dlg?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dlg.close()));

  // La barra si compatta scendendo nella pagina
  const t = document.querySelector<HTMLElement>('[data-testata]');
  const su = () => { t?.classList.toggle('testata--compatta', window.scrollY > 40); };
  addEventListener('scroll', su, { passive: true });
  su();
</script>

<style>
  .testata {
    position: fixed; inset: 16px 0 auto; z-index: 50;
    width: min(100% - 2 * var(--gutter), 1400px); margin-inline: auto;
    pointer-events: none;
  }
  .testata__barra {
    pointer-events: auto;
    display: flex; align-items: center; gap: 18px;
    min-height: 76px; padding: 10px 12px 10px 28px;
    border-radius: var(--r-pill);
    background: rgb(14 26 43 / 0.94);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 40px -18px rgb(14 26 43 / 0.55);
    transition: min-height var(--d-comp) var(--ease-out), transform var(--d-comp) var(--ease-out);
  }
  :global(.testata--compatta) .testata__barra { min-height: 66px; }
  .testata__logo { display: block; flex: none; padding: 8px 0; border-radius: 8px; }
  .testata__logo :global(.logo) { width: 168px; height: auto; }
  .testata__nav { margin-inline: auto; }
  .testata__nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .testata__nav li { margin: 0; }
  .testata__nav a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 16px;
    border-radius: var(--r-pill); color: var(--bianco); text-decoration: none; font-weight: 700; font-size: 1.0625rem;
    transition: background var(--d-micro) var(--ease-out);
  }
  .testata__nav a:hover { background: rgb(255 255 255 / 0.1); }
  .testata__nav a[aria-current='page'] { background: rgb(46 129 255 / 0.22); box-shadow: inset 0 -3px 0 var(--blu); }
  .testata__azioni { display: flex; gap: 10px; flex: none; }
  .testata__azioni .btn { min-height: 54px; }
  .testata__azioni .breve { display: none; }
  .testata__menu {
    display: none; margin-left: auto; align-items: center; gap: 8px; min-height: 52px; padding: 0 18px;
    border: 2px solid rgb(255 255 255 / 0.5); border-radius: var(--r-pill); background: transparent; color: var(--bianco);
    font-weight: 700; cursor: pointer;
  }
  @media (max-width: 1240px) {
    .testata__azioni .btn--secondario .lungo { display: none; }
    .testata__azioni .btn--secondario .breve { display: inline; }
    .testata__azioni .btn--secondario { padding: 0 18px; }
  }
  @media (max-width: 1080px) {
    .testata__nav, .testata__azioni .btn--secondario { display: none; }
    .testata__azioni { margin-left: auto; }
    .testata__menu { display: inline-flex; margin-left: 0; }
  }
  @media (max-width: 640px) {
    .testata { inset: 10px 0 auto; }
    .testata__barra { padding: 8px 8px 8px 20px; min-height: 66px; gap: 10px; }
    .testata__logo :global(.logo) { width: 132px; }
    .testata__prenota { display: none !important; }
    .testata__menu { margin-left: auto; }
  }

  .menu-mobile {
    pointer-events: auto; /* la testata ha pointer-events: none: il menu deve tornare cliccabile e scorrevole */
    width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; border: 0; padding: 22px var(--gutter) 40px;
    background: var(--inchiostro); color: var(--bianco); overflow-y: auto;
  }
  .menu-mobile[open] { animation: menu-in var(--d-comp) var(--ease-out); }
  @keyframes menu-in { from { clip-path: circle(0% at calc(100% - 60px) 50px); } to { clip-path: circle(150% at calc(100% - 60px) 50px); } }
  .menu-mobile::backdrop { background: rgb(14 26 43 / 0.6); }
  .menu-mobile__testa { display: flex; justify-content: space-between; align-items: center; margin-bottom: 36px; }
  .menu-mobile__testa :global(.logo) { width: 150px; }
  .menu-mobile__chiudi {
    display: inline-flex; align-items: center; gap: 8px; min-height: 52px; padding: 0 18px; border-radius: var(--r-pill);
    border: 2px solid rgb(255 255 255 / 0.5); background: transparent; color: var(--bianco); font-weight: 700; cursor: pointer;
  }
  .menu-mobile ul { list-style: none; padding: 0; margin: 0 0 32px; }
  .menu-mobile li { margin: 0; border-bottom: 1px solid rgb(255 255 255 / 0.14); }
  .menu-mobile nav a {
    display: block; padding: 16px 0; color: var(--bianco); text-decoration: none;
    font-family: var(--f-titoli); font-weight: 800; font-size: clamp(1.75rem, 7vw, 2.5rem); letter-spacing: -0.02em;
  }
  .menu-mobile nav a[aria-current='page'] { color: var(--blu); font-style: italic; }
  .menu-mobile__azioni { display: grid; gap: 12px; }
  .menu-mobile__azioni .btn { width: 100%; }
  .menu-mobile__tel { display: inline-flex; gap: 12px; align-items: center; margin-top: 12px; color: var(--bianco) !important; font-size: 1.4rem; font-weight: 700; text-decoration: none; }
</style>
