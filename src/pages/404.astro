---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { impostazioni as s } from '@/lib/content';
---
<Base titolo="Pagina non trovata | Monza CED" descrizione="La pagina che cerchi non esiste o è stata spostata." noindex>
  <section class="non-trovata">
    <svg class="filo non-trovata__filo" viewBox="0 0 1440 600" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M-20 420 C 200 300, 380 520, 620 380 S 900 120, 1080 260 S 1300 420, 1460 300" />
    </svg>
    <div class="contenitore">
      <p class="occhiello">Errore 404</p>
      <h1>Questa strada <em>non porta da nessuna parte.</em></h1>
      <p class="sottotesto">La pagina non esiste o è stata spostata. Ripartiamo da qui:</p>
      <div class="azioni">
        <a class="btn" href="/servizi">Vedi i servizi <Icon name="freccia" /></a>
        <a class="btn btn--secondario" href="/cerca"><Icon name="cerca" /> Cerca</a>
        <a class="btn btn--secondario" href="/">Torna alla home</a>
      </div>
      <p class="mt-l">Oppure chiamaci: <a href={`tel:${s.telefonoLink}`}>{s.telefono}</a>.</p>
    </div>
  </section>
</Base>
<style>
  .non-trovata { position: relative; min-height: 80svh; display: grid; align-content: center; padding: 150px 0 80px; overflow: hidden; }
  .non-trovata .contenitore { position: relative; z-index: 1; }
  .non-trovata h1 { max-width: 14ch; }
  .non-trovata__filo { inset: 0; width: 100%; height: 100%; opacity: 0.6; }
</style>
