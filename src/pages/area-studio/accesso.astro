---
import Studio from '@/layouts/Studio.astro';
import { utenteSessione } from '@/lib/server/accesso';
import { cfg } from '@/lib/server/config';
export const prerender = false;
if (utenteSessione(Astro.cookies)) return Astro.redirect('/area-studio');
const errore = Astro.url.searchParams.get('errore');
const otp = Astro.url.searchParams.get('otp') === '1';
const configurato = cfg().segreto.length >= 32 && !!cfg().utentiStudio;
Astro.response.headers.set('cache-control', 'no-store');
---
<Studio titolo="Accesso">
  <div class="contenitore-stretto scheda-studio studio-accesso">
    <h1 class="studio-h1">Accesso</h1>
    {!configurato && <div class="avviso avviso--errore"><p>L'area riservata non è ancora configurata (vedi README: SEGRETO_APP e UTENTI_STUDIO).</p></div>}
    {errore === 'credenziali' && <div class="avviso avviso--errore" role="alert"><p>Nome utente, password o codice non corretti.</p></div>}
    {errore === 'troppi' && <div class="avviso avviso--errore" role="alert"><p>Troppi tentativi. Riprova tra 15 minuti.</p></div>}
    <form method="post" action="/api/studio/accesso" class="mt-m">
      <div class="campo"><label for="u">Nome utente</label><input id="u" name="utente" type="text" autocomplete="username" required /></div>
      <div class="campo"><label for="p">Password</label><input id="p" name="password" type="password" autocomplete="current-password" required /></div>
      <div class="campo">
        <label for="o">Codice di verifica {otp ? '' : '(se attivo)'}</label>
        <input id="o" name="otp" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" required={otp} />
        <p class="aiuto">Il codice a 6 cifre dell'app di autenticazione, se per il tuo utente è attiva la verifica in due passaggi.</p>
      </div>
      <button class="btn" type="submit">Entra</button>
    </form>
  </div>
</Studio>
